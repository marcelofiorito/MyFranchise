<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="RunMyFranchise_Demo"
             targetNamespace="http://runmyfranchise.demo/bpmn"
             exporter="Joule + Marcelo Fiorito" exporterVersion="2.0">

  <!--
    RunMyFranchise — Fluxo da Demo (26/08/2026)
    v2 — corrigido para refletir a implementação real:
      ✓ Trigger: Gestor aciona análise manualmente (não "Venda registrada")
      ✓ Sem BPA — aprovação manual via Fiori app OU Joule (linguagem natural)
      ✓ Joule como canal alternativo de aprovação (principal diferencial)
      ✓ Intermediate catching event: Sistema aguarda aprovação antes de executar
      ✓ simularRecebimento via Admin app (não integração S/4HANA real)
      ✓ Franqueado via pull (acessa portal), não push/notificação
      ✓ Pool Franqueado simplificado (sem "ExecutaAcao" que não existe na demo)
    3 pools: Gestor (Franqueadora) | Sistema (RunMyFranchise) | Franqueado
  -->

  <collaboration id="Demo_Collaboration">
    <participant id="Pool_Gestor"     name="Gestor (Franqueadora)"    processRef="Process_Gestor"/>
    <participant id="Pool_Sistema"    name="Sistema (RunMyFranchise)" processRef="Process_Sistema"/>
    <participant id="Pool_Franqueado" name="Franqueado (Loja)"        processRef="Process_Franqueado"/>

    <!-- Gestor abre app → Sistema carrega dados -->
    <messageFlow id="mf1"  sourceRef="task_G_AbreEstoque"    targetRef="task_S_CarregaEstoque"/>
    <!-- Sistema retorna cobertura calculada → Gestor visualiza -->
    <messageFlow id="mf2"  sourceRef="task_S_GeraCobertura"  targetRef="task_G_VerCobertura"/>
    <!-- Sistema gera pedidos PENDENTE → Gestor vê no app -->
    <messageFlow id="mf3"  sourceRef="task_S_GeraRec"        targetRef="task_G_VerPedidos"/>
    <!-- Gestor aprova via app Fiori → Sistema recebe sinal de aprovação -->
    <messageFlow id="mf4a" sourceRef="task_G_AprovaApp"      targetRef="imce_S_WaitAprovacao"/>
    <!-- Gestor aprova via Joule → Sistema recebe sinal de aprovação -->
    <messageFlow id="mf4b" sourceRef="task_G_AprovaJoule"    targetRef="imce_S_WaitAprovacao"/>
    <!-- Admin executa simularRecebimento → Franqueado vê portal atualizado -->
    <messageFlow id="mf5"  sourceRef="task_S_SimularRec"     targetRef="task_F_AbrePortal"/>
    <!-- Recomendações da IA disponíveis → Franqueado lê no Portal -->
    <messageFlow id="mf6"  sourceRef="task_S_GeraRec"        targetRef="task_F_LeRecomendacoes"/>
  </collaboration>

  <!-- ═══════════════════════════════════════════════════════════
       POOL GESTOR
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_Gestor" isExecutable="false">

    <startEvent id="start_G" name="Demo inicia&#10;Painel da Rede">
      <outgoing>sf_G1</outgoing>
    </startEvent>

    <task id="task_G_AbreNetwork"
          name="Abre Painel da Rede&#10;— vê donut de criticidade&#10;(Crítico / Atenção / Saudável)">
      <incoming>sf_G1</incoming>
      <outgoing>sf_G2</outgoing>
    </task>

    <task id="task_G_FiltraRegiao"
          name="Filtra Estoque por Região&#10;NE → Havaianas em RUPTURA&#10;cobertura: 2,6 dias">
      <incoming>sf_G2</incoming>
      <outgoing>sf_G3</outgoing>
    </task>

    <task id="task_G_AbreEstoque"
          name="Abre app Estoque &amp; Reposição&#10;— dispara request ao sistema">
      <incoming>sf_G3</incoming>
      <outgoing>sf_G4</outgoing>
    </task>

    <task id="task_G_VerCobertura"
          name="Visualiza cobertura sazonal&#10;Recife NE: 2,6d → 🔴 RUPTURA&#10;Porto Alegre S: 66,7d → 🟢 OK">
      <incoming>sf_G4</incoming>
      <outgoing>sf_G5</outgoing>
    </task>

    <task id="task_G_AcionaAgente"
          name="Aciona Agente de Reposição&#10;gerarReposicao(u178)&#10;— aguarda gpt-4o">
      <incoming>sf_G5</incoming>
      <outgoing>sf_G6</outgoing>
    </task>

    <task id="task_G_VerPedidos"
          name="App Pedidos de Reposição:&#10;pedidos PENDENTE gerados pela IA&#10;— justificativa gpt-4o visível">
      <incoming>sf_G6</incoming>
      <outgoing>sf_G7</outgoing>
    </task>

    <!-- Diferencial: dois canais de aprovação -->
    <exclusiveGateway id="gw_G_Canal" name="Canal de&#10;aprovação?">
      <incoming>sf_G7</incoming>
      <outgoing>sf_G_app</outgoing>
      <outgoing>sf_G_joule</outgoing>
    </exclusiveGateway>

    <task id="task_G_AprovaApp"
          name="Aprova via app&#10;Pedidos de Reposição&#10;— botão Aprovar + diálogo">
      <incoming>sf_G_app</incoming>
      <outgoing>sf_G8a</outgoing>
    </task>

    <task id="task_G_AprovaJoule"
          name="Aprova via Joule&#10;(linguagem natural)&#10;'Aprova todos os pedidos&#10;de Havaianas pendentes'">
      <incoming>sf_G_joule</incoming>
      <outgoing>sf_G8b</outgoing>
    </task>

    <!-- Join: ambos os caminhos convergem -->
    <exclusiveGateway id="gw_G_Join" name="">
      <incoming>sf_G8a</incoming>
      <incoming>sf_G8b</incoming>
      <outgoing>sf_G9</outgoing>
    </exclusiveGateway>

    <exclusiveGateway id="gw_G_Resultado" name="Pedido aprovado?">
      <incoming>sf_G9</incoming>
      <outgoing>sf_G10_sim</outgoing>
      <outgoing>sf_G10_nao</outgoing>
    </exclusiveGateway>

    <task id="task_G_Recusa"
          name="Recusa pedido&#10;→ status RECUSADO">
      <incoming>sf_G10_nao</incoming>
      <outgoing>sf_G11</outgoing>
    </task>

    <endEvent id="end_G_ok" name="Reposição&#10;aprovada">
      <incoming>sf_G10_sim</incoming>
    </endEvent>

    <endEvent id="end_G_nao" name="Pedido&#10;recusado">
      <incoming>sf_G11</incoming>
    </endEvent>

    <sequenceFlow id="sf_G1"      sourceRef="start_G"           targetRef="task_G_AbreNetwork"/>
    <sequenceFlow id="sf_G2"      sourceRef="task_G_AbreNetwork" targetRef="task_G_FiltraRegiao"/>
    <sequenceFlow id="sf_G3"      sourceRef="task_G_FiltraRegiao" targetRef="task_G_AbreEstoque"/>
    <sequenceFlow id="sf_G4"      sourceRef="task_G_AbreEstoque" targetRef="task_G_VerCobertura"/>
    <sequenceFlow id="sf_G5"      sourceRef="task_G_VerCobertura" targetRef="task_G_AcionaAgente"/>
    <sequenceFlow id="sf_G6"      sourceRef="task_G_AcionaAgente" targetRef="task_G_VerPedidos"/>
    <sequenceFlow id="sf_G7"      sourceRef="task_G_VerPedidos"  targetRef="gw_G_Canal"/>
    <sequenceFlow id="sf_G_app"   name="Via Fiori app" sourceRef="gw_G_Canal" targetRef="task_G_AprovaApp"/>
    <sequenceFlow id="sf_G_joule" name="Via Joule"     sourceRef="gw_G_Canal" targetRef="task_G_AprovaJoule"/>
    <sequenceFlow id="sf_G8a"     sourceRef="task_G_AprovaApp"   targetRef="gw_G_Join"/>
    <sequenceFlow id="sf_G8b"     sourceRef="task_G_AprovaJoule" targetRef="gw_G_Join"/>
    <sequenceFlow id="sf_G9"      sourceRef="gw_G_Join"          targetRef="gw_G_Resultado"/>
    <sequenceFlow id="sf_G10_sim" name="Sim" sourceRef="gw_G_Resultado" targetRef="end_G_ok"/>
    <sequenceFlow id="sf_G10_nao" name="Não" sourceRef="gw_G_Resultado" targetRef="task_G_Recusa"/>
    <sequenceFlow id="sf_G11"     sourceRef="task_G_Recusa"      targetRef="end_G_nao"/>
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       POOL SISTEMA
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_Sistema" isExecutable="false">

    <!-- Acionado por mf1 (Gestor abre app) -->
    <task id="task_S_CarregaEstoque"
          name="Carrega Estoque_Unidade&#10;+ Sazonalidade_Regional&#10;+ Calendario_Promocional">
      <outgoing>sf_S1</outgoing>
    </task>

    <task id="task_S_GeraCobertura"
          name="Calcula coberturaDias&#10;= saldo / (giro × fatorSazonal × uplift)&#10;→ estoqueCriticality (1/2/3)">
      <incoming>sf_S1</incoming>
      <outgoing>sf_S2</outgoing>
    </task>

    <exclusiveGateway id="gw_S_Ruptura" name="coberturaDias &#60; leadTimeDias?">
      <incoming>sf_S2</incoming>
      <outgoing>sf_S3_sim</outgoing>
      <outgoing>sf_S3_nao</outgoing>
    </exclusiveGateway>

    <!-- Agente de reposição (gpt-4o) -->
    <task id="task_S_GeraRec"
          name="Agente gpt-4o (reposicao-agent.js)&#10;— prompt com contexto sazonal&#10;— gera Pedidos_Reposicao (PENDENTE)">
      <incoming>sf_S3_sim</incoming>
      <outgoing>sf_S4</outgoing>
    </task>

    <task id="task_S_SemRuptura"
          name="Sem risco de ruptura&#10;— nenhuma ação necessária">
      <incoming>sf_S3_nao</incoming>
      <outgoing>sf_S_nao</outgoing>
    </task>

    <!-- Intermediate catching message event: aguarda aprovação do Gestor
         Recebe mf4a (via app) OU mf4b (via Joule) -->
    <intermediateCatchEvent id="imce_S_WaitAprovacao"
                            name="Aguarda aprovação&#10;(app ou Joule)">
      <incoming>sf_S4</incoming>
      <outgoing>sf_S5</outgoing>
      <messageEventDefinition/>
    </intermediateCatchEvent>

    <!-- Bound action: aprovarPedido() -->
    <task id="task_S_ExecutaAprovacao"
          name="Bound action aprovarPedido()&#10;→ status APROVADO&#10;→ registra usuário + timestamp">
      <incoming>sf_S5</incoming>
      <outgoing>sf_S6</outgoing>
    </task>

    <!-- Admin app: simularRecebimento() -->
    <task id="task_S_SimularRec"
          name="Admin app: simularRecebimento()&#10;APROVADO → RECEBIDO&#10;+ saldo reposto no estoque">
      <incoming>sf_S6</incoming>
      <outgoing>sf_S7</outgoing>
    </task>

    <!-- Franqueado vê por pull (não há notificação push na demo) -->
    <task id="task_S_AtualizaPortal"
          name="Portal do Franqueado atualizado&#10;— status e saldo visíveis por pull&#10;(sem push/notificação na demo)">
      <incoming>sf_S7</incoming>
      <outgoing>sf_S8</outgoing>
    </task>

    <endEvent id="end_S_ok" name="Estoque&#10;reposto">
      <incoming>sf_S8</incoming>
    </endEvent>

    <endEvent id="end_S_nao" name="Sem&#10;ruptura">
      <incoming>sf_S_nao</incoming>
    </endEvent>

    <sequenceFlow id="sf_S1"      sourceRef="task_S_CarregaEstoque"   targetRef="task_S_GeraCobertura"/>
    <sequenceFlow id="sf_S2"      sourceRef="task_S_GeraCobertura"    targetRef="gw_S_Ruptura"/>
    <sequenceFlow id="sf_S3_sim"  name="Sim" sourceRef="gw_S_Ruptura" targetRef="task_S_GeraRec"/>
    <sequenceFlow id="sf_S3_nao"  name="Não" sourceRef="gw_S_Ruptura" targetRef="task_S_SemRuptura"/>
    <sequenceFlow id="sf_S4"      sourceRef="task_S_GeraRec"          targetRef="imce_S_WaitAprovacao"/>
    <sequenceFlow id="sf_S5"      sourceRef="imce_S_WaitAprovacao"    targetRef="task_S_ExecutaAprovacao"/>
    <sequenceFlow id="sf_S6"      sourceRef="task_S_ExecutaAprovacao" targetRef="task_S_SimularRec"/>
    <sequenceFlow id="sf_S7"      sourceRef="task_S_SimularRec"       targetRef="task_S_AtualizaPortal"/>
    <sequenceFlow id="sf_S8"      sourceRef="task_S_AtualizaPortal"   targetRef="end_S_ok"/>
    <sequenceFlow id="sf_S_nao"   sourceRef="task_S_SemRuptura"       targetRef="end_S_nao"/>
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       POOL FRANQUEADO
       ═══════════════════════════════════════════════════════════ -->
  <process id="Process_Franqueado" isExecutable="false">

    <!-- Acessa portal por pull (não recebe push) -->
    <task id="task_F_AbrePortal"
          name="Acessa Portal do Franqueado&#10;— 5 cards: Score, KPIs,&#10;Recomendações, Benchmark">
      <outgoing>sf_F1</outgoing>
    </task>

    <!-- Recomendações geradas pelo agente gpt-4o -->
    <task id="task_F_LeRecomendacoes"
          name="Lê Recomendações da IA (gpt-4o)&#10;— SKU, prioridade, impacto&#10;— ação concreta com prazo">
      <incoming>sf_F1</incoming>
      <outgoing>sf_F2</outgoing>
    </task>

    <endEvent id="end_F" name="Franqueado&#10;informado">
      <incoming>sf_F2</incoming>
    </endEvent>

    <sequenceFlow id="sf_F1" sourceRef="task_F_AbrePortal"      targetRef="task_F_LeRecomendacoes"/>
    <sequenceFlow id="sf_F2" sourceRef="task_F_LeRecomendacoes" targetRef="end_F"/>
  </process>

  <!-- ═══════════════════════════════════════════════════════════
       DIAGRAM — coordenadas para draw.io / bpmn.io
       ═══════════════════════════════════════════════════════════ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Demo_Collaboration">

      <!-- ── Pool Gestor (mais largo para acomodar o fork Joule) ── -->
      <bpmndi:BPMNShape id="shape_Pool_Gestor" bpmnElement="Pool_Gestor" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1810" height="290"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_start_G" bpmnElement="start_G">
        <dc:Bounds x="212" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_AbreNetwork" bpmnElement="task_G_AbreNetwork">
        <dc:Bounds x="290" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_FiltraRegiao" bpmnElement="task_G_FiltraRegiao">
        <dc:Bounds x="455" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_AbreEstoque" bpmnElement="task_G_AbreEstoque">
        <dc:Bounds x="620" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_VerCobertura" bpmnElement="task_G_VerCobertura">
        <dc:Bounds x="785" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_AcionaAgente" bpmnElement="task_G_AcionaAgente">
        <dc:Bounds x="950" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_VerPedidos" bpmnElement="task_G_VerPedidos">
        <dc:Bounds x="1115" y="135" width="130" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Gateway canal -->
      <bpmndi:BPMNShape id="shape_gw_G_Canal" bpmnElement="gw_G_Canal" isMarkerVisible="true">
        <dc:Bounds x="1295" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Via app (caminho superior) -->
      <bpmndi:BPMNShape id="shape_G_AprovaApp" bpmnElement="task_G_AprovaApp">
        <dc:Bounds x="1395" y="110" width="135" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Via Joule (caminho inferior — destaque) -->
      <bpmndi:BPMNShape id="shape_G_AprovaJoule" bpmnElement="task_G_AprovaJoule">
        <dc:Bounds x="1395" y="245" width="135" height="90"/>
      </bpmndi:BPMNShape>

      <!-- Join -->
      <bpmndi:BPMNShape id="shape_gw_G_Join" bpmnElement="gw_G_Join" isMarkerVisible="true">
        <dc:Bounds x="1580" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <!-- Resultado -->
      <bpmndi:BPMNShape id="shape_gw_G_Resultado" bpmnElement="gw_G_Resultado" isMarkerVisible="true">
        <dc:Bounds x="1680" y="150" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_end_G_ok" bpmnElement="end_G_ok">
        <dc:Bounds x="1790" y="157" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_G_Recusa" bpmnElement="task_G_Recusa">
        <dc:Bounds x="1780" y="255" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end_G_nao" bpmnElement="end_G_nao">
        <dc:Bounds x="1928" y="273" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Pool Sistema ── -->
      <bpmndi:BPMNShape id="shape_Pool_Sistema" bpmnElement="Pool_Sistema" isHorizontal="true">
        <dc:Bounds x="150" y="410" width="1810" height="250"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_S_CarregaEstoque" bpmnElement="task_S_CarregaEstoque">
        <dc:Bounds x="620" y="455" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_S_GeraCobertura" bpmnElement="task_S_GeraCobertura">
        <dc:Bounds x="785" y="455" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_gw_S_Ruptura" bpmnElement="gw_S_Ruptura" isMarkerVisible="true">
        <dc:Bounds x="950" y="470" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_S_GeraRec" bpmnElement="task_S_GeraRec">
        <dc:Bounds x="1055" y="455" width="130" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_S_SemRuptura" bpmnElement="task_S_SemRuptura">
        <dc:Bounds x="1055" y="570" width="120" height="55"/>
      </bpmndi:BPMNShape>

      <!-- Intermediate catching event: envelope/mensagem -->
      <bpmndi:BPMNShape id="shape_imce_S_WaitAprovacao" bpmnElement="imce_S_WaitAprovacao">
        <dc:Bounds x="1237" y="477" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_S_ExecutaAprovacao" bpmnElement="task_S_ExecutaAprovacao">
        <dc:Bounds x="1320" y="455" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_S_SimularRec" bpmnElement="task_S_SimularRec">
        <dc:Bounds x="1505" y="455" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_S_AtualizaPortal" bpmnElement="task_S_AtualizaPortal">
        <dc:Bounds x="1690" y="455" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end_S_ok" bpmnElement="end_S_ok">
        <dc:Bounds x="1880" y="477" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end_S_nao" bpmnElement="end_S_nao">
        <dc:Bounds x="1220" y="580" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Pool Franqueado ── -->
      <bpmndi:BPMNShape id="shape_Pool_Franqueado" bpmnElement="Pool_Franqueado" isHorizontal="true">
        <dc:Bounds x="150" y="700" width="1810" height="170"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="shape_F_AbrePortal" bpmnElement="task_F_AbrePortal">
        <dc:Bounds x="1505" y="735" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_F_LeRecomendacoes" bpmnElement="task_F_LeRecomendacoes">
        <dc:Bounds x="1055" y="735" width="135" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_end_F" bpmnElement="end_F">
        <dc:Bounds x="1760" y="757" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <!-- ── Sequence flows — Gestor ── -->
      <bpmndi:BPMNEdge id="edge_sf_G1"      bpmnElement="sf_G1">      <di:waypoint x="248" y="175"/> <di:waypoint x="290" y="175"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G2"      bpmnElement="sf_G2">      <di:waypoint x="410" y="175"/> <di:waypoint x="455" y="175"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G3"      bpmnElement="sf_G3">      <di:waypoint x="575" y="175"/> <di:waypoint x="620" y="175"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G4"      bpmnElement="sf_G4">      <di:waypoint x="740" y="175"/> <di:waypoint x="785" y="175"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G5"      bpmnElement="sf_G5">      <di:waypoint x="905" y="175"/> <di:waypoint x="950" y="175"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G6"      bpmnElement="sf_G6">      <di:waypoint x="1070" y="175"/><di:waypoint x="1115" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G7"      bpmnElement="sf_G7">      <di:waypoint x="1245" y="175"/><di:waypoint x="1295" y="175"/></bpmndi:BPMNEdge>
      <!-- Fork: via app (sobe) -->
      <bpmndi:BPMNEdge id="edge_sf_G_app"   bpmnElement="sf_G_app">
        <di:waypoint x="1320" y="160"/>
        <di:waypoint x="1357" y="150"/>
        <di:waypoint x="1395" y="150"/>
      </bpmndi:BPMNEdge>
      <!-- Fork: via Joule (desce) -->
      <bpmndi:BPMNEdge id="edge_sf_G_joule" bpmnElement="sf_G_joule">
        <di:waypoint x="1320" y="190"/>
        <di:waypoint x="1357" y="290"/>
        <di:waypoint x="1395" y="290"/>
      </bpmndi:BPMNEdge>
      <!-- Join: app sobe para join -->
      <bpmndi:BPMNEdge id="edge_sf_G8a" bpmnElement="sf_G8a">
        <di:waypoint x="1530" y="150"/>
        <di:waypoint x="1555" y="165"/>
        <di:waypoint x="1580" y="175"/>
      </bpmndi:BPMNEdge>
      <!-- Join: joule sobe para join -->
      <bpmndi:BPMNEdge id="edge_sf_G8b" bpmnElement="sf_G8b">
        <di:waypoint x="1530" y="290"/>
        <di:waypoint x="1555" y="200"/>
        <di:waypoint x="1580" y="185"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G9"      bpmnElement="sf_G9">      <di:waypoint x="1630" y="175"/><di:waypoint x="1680" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G10_sim" bpmnElement="sf_G10_sim"> <di:waypoint x="1730" y="175"/><di:waypoint x="1790" y="175"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G10_nao" bpmnElement="sf_G10_nao">
        <di:waypoint x="1705" y="200"/>
        <di:waypoint x="1705" y="285"/>
        <di:waypoint x="1780" y="285"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_G11"     bpmnElement="sf_G11">     <di:waypoint x="1890" y="285"/><di:waypoint x="1928" y="291"/></bpmndi:BPMNEdge>

      <!-- ── Sequence flows — Sistema ── -->
      <bpmndi:BPMNEdge id="edge_sf_S1"      bpmnElement="sf_S1">      <di:waypoint x="740" y="495"/> <di:waypoint x="785" y="495"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S2"      bpmnElement="sf_S2">      <di:waypoint x="905" y="495"/> <di:waypoint x="950" y="495"/> </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S3_sim"  bpmnElement="sf_S3_sim">  <di:waypoint x="1000" y="495"/><di:waypoint x="1055" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S3_nao"  bpmnElement="sf_S3_nao">
        <di:waypoint x="975" y="520"/>
        <di:waypoint x="975" y="597"/>
        <di:waypoint x="1055" y="597"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S4"      bpmnElement="sf_S4">      <di:waypoint x="1185" y="495"/><di:waypoint x="1237" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S5"      bpmnElement="sf_S5">      <di:waypoint x="1273" y="495"/><di:waypoint x="1320" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S6"      bpmnElement="sf_S6">      <di:waypoint x="1455" y="495"/><di:waypoint x="1505" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S7"      bpmnElement="sf_S7">      <di:waypoint x="1640" y="495"/><di:waypoint x="1690" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S8"      bpmnElement="sf_S8">      <di:waypoint x="1825" y="495"/><di:waypoint x="1880" y="495"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_S_nao"   bpmnElement="sf_S_nao">   <di:waypoint x="1175" y="597"/><di:waypoint x="1220" y="598"/></bpmndi:BPMNEdge>

      <!-- ── Sequence flows — Franqueado ── -->
      <!-- Nota: flows visualmente vão da direita para a esquerda no pool Franqueado -->
      <bpmndi:BPMNEdge id="edge_sf_F1" bpmnElement="sf_F1">
        <di:waypoint x="1505" y="775"/>
        <di:waypoint x="1330" y="775"/>
        <di:waypoint x="1190" y="775"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_sf_F2" bpmnElement="sf_F2">
        <di:waypoint x="1190" y="775"/>
        <di:waypoint x="1500" y="775"/>
        <di:waypoint x="1760" y="775"/>
      </bpmndi:BPMNEdge>

      <!-- ── Message flows (entre pools) ── -->
      <!-- mf1: Gestor abre app → Sistema carrega dados -->
      <bpmndi:BPMNEdge id="edge_mf1" bpmnElement="mf1">
        <di:waypoint x="680" y="215"/>
        <di:waypoint x="680" y="455"/>
      </bpmndi:BPMNEdge>

      <!-- mf2: Sistema retorna cobertura → Gestor visualiza -->
      <bpmndi:BPMNEdge id="edge_mf2" bpmnElement="mf2">
        <di:waypoint x="845" y="455"/>
        <di:waypoint x="845" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- mf3: Agente gera pedidos PENDENTE → Gestor vê no app -->
      <bpmndi:BPMNEdge id="edge_mf3" bpmnElement="mf3">
        <di:waypoint x="1120" y="455"/>
        <di:waypoint x="1180" y="215"/>
      </bpmndi:BPMNEdge>

      <!-- mf4a: Gestor aprova via app → Intermediate catching event -->
      <bpmndi:BPMNEdge id="edge_mf4a" bpmnElement="mf4a">
        <di:waypoint x="1462" y="190"/>
        <di:waypoint x="1462" y="330"/>
        <di:waypoint x="1255" y="477"/>
      </bpmndi:BPMNEdge>

      <!-- mf4b: Gestor aprova via Joule → Intermediate catching event -->
      <bpmndi:BPMNEdge id="edge_mf4b" bpmnElement="mf4b">
        <di:waypoint x="1462" y="335"/>
        <di:waypoint x="1462" y="400"/>
        <di:waypoint x="1255" y="477"/>
      </bpmndi:BPMNEdge>

      <!-- mf5: simularRecebimento → Franqueado acessa portal -->
      <bpmndi:BPMNEdge id="edge_mf5" bpmnElement="mf5">
        <di:waypoint x="1572" y="535"/>
        <di:waypoint x="1572" y="735"/>
      </bpmndi:BPMNEdge>

      <!-- mf6: Recomendações geradas → Franqueado lê no portal -->
      <bpmndi:BPMNEdge id="edge_mf6" bpmnElement="mf6">
        <di:waypoint x="1120" y="535"/>
        <di:waypoint x="1120" y="735"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
