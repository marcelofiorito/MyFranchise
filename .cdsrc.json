{
  "i18n": {
    "default_language": "en",
    "fallback_bundle": "i18n",
    "languages": ["pt", "en"]
  },
  "odata": {
    "version": "v4"
  },
  "requires": {
    "aicore": {
      "kind": "rest",
      "[production]": {
        "vcap": { "label": "aicore" }
      }
    },
    "messaging": {
      "kind": "file-based-messaging",
      "format": "cloudevents",
      "[production]": {
        "kind": "advanced-event-mesh",
        "impl": "./srv/aem-patched.js",
        "skipManagement": true,
        "queue": {
          "name": "myfranchise-srv/f3901205"
        },
        "consumer": {
          "queueDescriptor": {
            "name": "myfranchise-srv/f3901205",
            "type": "Queue"
          },
          "acknowledgeMode": "CLIENT",
          "requiredSettlementOutcomes": []
        }
      }
    }
  },
  "log": {
    "levels": {
      "cds": "warn",
      "messaging": "info",
      "ai-reposicao": "info",
      "ai-recommendations": "info"
    }
  }
}
