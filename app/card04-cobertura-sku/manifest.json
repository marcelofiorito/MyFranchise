{
  "_version": "1.15.0",
  "sap.app": {
    "id": "tropicalia.card04.cobertura.sku",
    "type": "card",
    "title": "Cobertura por SKU",
    "subTitle": "Top 6 SKUs — dias de cobertura",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.card": {
    "type": "Analytical",
    "header": {
      "title": "Cobertura por SKU",
      "subTitle": "Dias de estoque disponível — minha loja"
    },
    "content": {
      "chartType": "HorizontalBar",
      "legend": { "visible": false },
      "plotArea": {
        "dataLabel": { "visible": true }
      },
      "title": {
        "text": "Cobertura (dias)",
        "visible": true,
        "alignment": "Center"
      },
      "measureAxis": "valueAxis",
      "dimensionAxis": "categoryAxis",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueado/MeuEstoque?$apply=groupby((sku),aggregate(coberturaDias with average as mediaCobertura))&$orderby=mediaCobertura asc&$top=6",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "label": "SKU",
          "value": "{sku}"
        }
      ],
      "measures": [
        {
          "label": "Cobertura (dias)",
          "value": "{mediaCobertura}"
        }
      ]
    }
  }
}
