{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.network",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Network Overview",
    "description": "Franchise network health — scores, performance and compliance",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "NetworkPanel-display": {
          "semanticObject": "NetworkPanel",
          "action": "display",
          "title": "Network Overview",
          "subTitle": "Franchise network health — scores, performance and compliance",
          "icon": "sap-icon://org-chart",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://org-chart"
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "myfranchise.network.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "PainelRede",
          "pattern": ":?query:",
          "target": "PainelRede"
        },
        {
          "name": "UnidadeObjectPage",
          "pattern": "Unidades({key}):?query:",
          "target": "UnidadeObjectPage"
        }
      ],
      "targets": {
        "PainelRede": {
          "type": "Component",
          "id": "PainelRede",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Saude_Dashboard",
              "variantManagement": "Page",
              "initialLoad": "Enabled",
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                }
              },
              "views": {
                "paths": [
                  {
                    "primary": [
                      {
                        "annotationPath": "@com.sap.vocabularies.UI.v1.PresentationVariant"
                      }
                    ],
                    "secondary": [
                      {
                        "annotationPath": "@com.sap.vocabularies.UI.v1.PresentationVariant"
                      }
                    ],
                    "defaultPath": "both"
                  }
                ]
              }
            }
          }
        },
        "UnidadeObjectPage": {
          "type": "Component",
          "id": "UnidadeObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Unidades",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  },
  "sap.fiori": {
    "registrationIds": [
      "myfranchise-network-panel"
    ],
    "archeType": "analytical"
  }
}