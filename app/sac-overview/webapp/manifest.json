{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.sacoverview",
    "type": "application",
    "title": "Franchisor Dashboard",
    "description": "Strategic KPI dashboard — margins, campaigns and network performance",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "crossNavigation": {
      "inbounds": {
        "SACOverview-display": {
          "semanticObject": "SACOverview",
          "action": "display",
          "title": "Franchisor Dashboard",
          "subTitle": "Strategic KPI dashboard — margins, campaigns and network performance",
          "icon": "sap-icon://bar-chart",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://bar-chart"
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "myfranchise.sacoverview.view.Main",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "flexEnabled": false
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  },
  "sap.fiori": {
    "registrationIds": [
      "myfranchise-sac-overview"
    ],
    "archeType": "analytical"
  }
}