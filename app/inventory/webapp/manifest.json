{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.inventory",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Network Stock Monitor",
    "description": "Stock coverage and risk across all franchise stores",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Inventory-manage": {
          "semanticObject": "Inventory",
          "action": "manage",
          "title": "Network Stock Monitor",
          "subTitle": "Stock coverage and risk across all franchise stores",
          "icon": "sap-icon://retail-store",
          "numberUnit": "in stockout",
          "numberState": "Negative",
          "indicatorDataSource": {
            "dataSource": "mainService",
            "path": "Estoque_Unidade/$count?$filter=status_code%20eq%20%27RUPTURA%27",
            "refresh": 30
          },
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://retail-store"
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "myfranchise.inventory.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "EstoqueList",
          "pattern": ":?query:",
          "target": "EstoqueList"
        },
        {
          "name": "EstoqueObjectPage",
          "pattern": "Estoque_Unidade({key}):?query:",
          "target": "EstoqueObjectPage"
        }
      ],
      "targets": {
        "EstoqueList": {
          "type": "Component",
          "id": "EstoqueList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Estoque_Unidade",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Estoque_Unidade": {
                  "detail": {
                    "route": "EstoqueObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "EstoqueObjectPage": {
          "type": "Component",
          "id": "EstoqueObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Estoque_Unidade",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  },
  "sap.fiori": {
    "registrationIds": [
      "myfranchise-inventory"
    ],
    "archeType": "transactional"
  }
}