{
  "_version": "1.15.0",
  "sap.app": {
    "id": "tropicalia.card05.pedidos.pendentes",
    "type": "card",
    "title": "Pedidos de Reposição",
    "subTitle": "Aguardando aprovação",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.card": {
    "type": "Table",
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueado/MinhasReposicoes/$count?$filter=status_code eq 'PENDENTE'",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        }
      },
      "title": "Pedidos de Reposição",
      "subTitle": "Pendentes de aprovação",
      "unitOfMeasurement": "pedidos",
      "mainIndicator": {
        "number": "{/}",
        "state": "{= ${/} > 5 ? 'Critical' : ${/} > 0 ? 'None' : 'Good'}"
      }
    },
    "content": {
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueado/MinhasReposicoes?$filter=status_code eq 'PENDENTE'&$orderby=dataPedido desc&$top=8&$select=ID,sku,qtdSugerida,status_code,dataPedido",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        },
        "path": "/value"
      },
      "row": {
        "columns": [
          {
            "title": "SKU",
            "value": "{sku}",
            "width": "30%"
          },
          {
            "title": "Qtd",
            "value": "{qtdSugerida}",
            "hAlign": "End",
            "width": "15%"
          },
          {
            "title": "Data",
            "value": "{dataPedido}",
            "width": "25%"
          },
          {
            "title": "Status",
            "value": "{status_code}",
            "state": "{= ${status_code} === 'PENDENTE' ? 'Warning' : ${status_code} === 'APROVADO' ? 'Success' : ${status_code} === 'RECUSADO' ? 'Error' : 'None'}",
            "width": "30%"
          }
        ]
      }
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Ver todos os pedidos",
          "type": "Navigation",
          "parameters": {
            "ibnTarget": {
              "semanticObject": "ReplenishmentPortal",
              "action": "display"
            }
          }
        }
      ]
    }
  }
}
