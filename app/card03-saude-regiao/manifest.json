{
  "_version": "1.15.0",
  "sap.app": {
    "id": "tropicalia.card03.saude.regiao",
    "type": "card",
    "title": "Saúde da Rede por Região",
    "subTitle": "Score médio de saúde",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.card": {
    "type": "Analytical",
    "header": {
      "title": "Saúde da Rede por Região",
      "subTitle": "Score médio — todas as lojas ativas"
    },
    "content": {
      "chartType": "Bar",
      "legend": { "visible": false },
      "plotArea": {
        "dataLabel": { "visible": true },
        "colorPalette": []
      },
      "title": {
        "text": "Score de Saúde (0–100)",
        "visible": true,
        "alignment": "Center"
      },
      "measureAxis": "valueAxis",
      "dimensionAxis": "categoryAxis",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueador/Saude_Unidade?$apply=groupby((unidade/regiao_code),aggregate(scoreSaude with average as mediaScore))&$orderby=mediaScore desc&$top=5",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "label": "Região",
          "value": "{unidade/regiao_code}"
        }
      ],
      "measures": [
        {
          "label": "Score Médio",
          "value": "{mediaScore}"
        }
      ]
    }
  }
}
