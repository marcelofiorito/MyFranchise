{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.home",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "Executive Home",
    "description": "Network revenue, customers, highlights and AI insights",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ExecutiveHome-display": {
          "semanticObject": "ExecutiveHome",
          "action": "display",
          "title": "Executive Home",
          "subTitle": "Network revenue, customers and AI insights",
          "icon": "sap-icon://home",
          "signature": { "parameters": {}, "additionalParameters": "allowed" }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://home" },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "sap.ovp.app.Main",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": { "sap.m": {}, "sap.ui.core": {}, "sap.ovp": {} }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "myfranchise.home.i18n.i18n" }
      }
    }
  },
  "sap.ovp": {
    "enableLiveFilter": false,
    "considerAnalyticalParameters": false,
    "cards": {
      "card00_revenue": {
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "Network Revenue",
          "subTitle": "Quarterly performance — all 300 stores",
          "entitySet": "KPI_Rede",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Revenue",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#ByPeriod"
        }
      },
      "card01_highlights": {
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Today's Highlights",
          "subTitle": "Meetings and deliveries for today",
          "entitySet": "Atividades_Rede",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Highlights",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Hoje",
          "sortBy": "horario",
          "sortOrder": "ascending",
          "listType": "extended"
        }
      },
      "card02_activities": {
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Recent Activities",
          "subTitle": "Open items requiring attention",
          "entitySet": "Atividades_Rede",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Activities",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Abertos",
          "sortBy": "data",
          "sortOrder": "descending",
          "listType": "extended"
        }
      },
      "card03_kpis": {
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "Network KPIs",
          "subTitle": "NPS · Gross Margin · Store Count",
          "entitySet": "KPI_Rede",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#KPIs",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#ByPeriod"
        }
      }
    }
  },
  "sap.cloud": { "public": true, "service": "myfranchise.service" },
  "sap.fiori": {
    "registrationIds": ["myfranchise-home"],
    "archeType": "analytical"
  }
}
