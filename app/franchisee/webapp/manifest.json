{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.franchisee",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "franqueado/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "FranchiseePortal-display": {
          "semanticObject": "FranchiseePortal",
          "action": "display",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://home",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://home"
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "rootView": {
      "viewName": "sap.ovp.app.Main",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ovp": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "myfranchise.franchisee.i18n.i18n"
        }
      }
    }
  },
  "sap.ovp": {
    "enableLiveFilter": true,
    "considerAnalyticalParameters": false,
    "cards": {
      "card00_kpis": {
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "My Performance",
          "subTitle": "{{appStoreName}} · last 6 months",
          "entitySet": "MeusKPIs",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Trend",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#ByPeriod"
        }
      },
      "card01_saude": {
        "template": "sap.ovp.cards.v4.kpiHeader",
        "settings": {
          "title": "Health Score",
          "subTitle": "{{appStoreName}} · vs. cluster average",
          "entitySet": "MinhaSaude",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#ScoreSaude",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Current",
          "addODataSelect": true
        }
      },
      "card02_acoes": {
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Pending Actions",
          "subTitle": "{{appStoreName}} · requires attention",
          "entitySet": "MeusDesvios",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Pendentes",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Abertos",
          "sortBy": "dataDeteccao",
          "sortOrder": "descending",
          "listType": "extended"
        }
      },
      "card03_recomendacoes": {
        "template": "sap.ovp.cards.v4.stack",
        "settings": {
          "title": "AI Recommendations",
          "subTitle": "{{appStoreName}} · AI assistant",
          "entitySet": "MinhasRecomendacoes",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Recomendacoes",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Novas",
          "sortBy": "prioridade_code",
          "sortOrder": "ascending"
        }
      },
      "card04_benchmark": {
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "Network Position",
          "subTitle": "Cluster STD · anonymized average",
          "entitySet": "BenchmarkMeuCluster",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Benchmark",
          "presentationAnnotationPath": "com.sap.vocabularies.UI.v1.PresentationVariant#ByPeriod"
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  },
  "sap.fiori": {
    "registrationIds": [
      "myfranchise-franchisee-portal"
    ],
    "archeType": "analytical"
  }
}