{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.replenishment",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Replenishment-manage": {
          "semanticObject": "Replenishment",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://product",
          "numberUnit": "pending",
          "numberState": "Negative",
          "indicatorDataSource": {
            "dataSource": "mainService",
            "path": "Pedidos_Reposicao/$count?$filter=status_code%20eq%20%27PENDENTE%27",
            "refresh": 30
          },
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://product"
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "models": {
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "myfranchise.replenishment.i18n.i18n"
        }
      }
    },
    "routing": {
      "routes": [
        {
          "name": "PedidosList",
          "pattern": ":?query:",
          "target": "PedidosList"
        },
        {
          "name": "PedidoObjectPage",
          "pattern": "Pedidos_Reposicao({key}):?query:",
          "target": "PedidoObjectPage"
        }
      ],
      "targets": {
        "PedidosList": {
          "type": "Component",
          "id": "PedidosList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Pedidos_Reposicao",
              "variantManagement": "Page",
              "initialLoad": true,
              "navigation": {
                "Pedidos_Reposicao": {
                  "detail": {
                    "route": "PedidoObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          }
        },
        "PedidoObjectPage": {
          "type": "Component",
          "id": "PedidoObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "contextPath": "/Pedidos_Reposicao",
              "editableHeaderContent": false
            }
          }
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  },
  "sap.fiori": {
    "registrationIds": [
      "myfranchise-replenishment"
    ],
    "archeType": "transactional"
  }
}
