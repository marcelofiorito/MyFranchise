<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:f="sap.f"
  xmlns:layout="sap.ui.layout"
  controllerName="myfranchise.admin.controller.Main"
  displayBlock="true">

  <App>
    <Page title="Tropicália Co. — Demo Control Panel" showNavButton="false">
      <content>
        <layout:VerticalLayout width="100%" class="sapUiMediumMargin">

          <!-- KPIs ao vivo -->
          <Panel headerText="Live Status" expandable="false">
            <content>
              <HBox wrap="Wrap" alignItems="Center" class="sapUiSmallMargin">
                <ObjectStatus
                  title="Pending Orders"
                  text="{admin>/pendentes}"
                  state="{admin>/pendentesState}"
                  class="sapUiMediumMarginEnd"/>
                <ObjectStatus
                  title="Items in STOCKOUT"
                  text="{admin>/ruptura}"
                  state="Error"
                  class="sapUiMediumMarginEnd"/>
                <Button
                  text="Refresh"
                  icon="sap-icon://refresh"
                  press=".onRefresh"
                  class="sapUiSmallMarginEnd"/>
              </HBox>
            </content>
          </Panel>

          <!-- Demo Flow Actions -->
          <Panel headerText="Demo Flow — Stockout Rupture" expandable="false">
            <content>
              <VBox class="sapUiSmallMargin">

                <Title text="Step 1 — Reset" class="sapUiSmallMarginBottom" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Reset Demo (all stocks healthy)"
                    type="Emphasized"
                    icon="sap-icon://reset"
                    press=".onResetarDemo"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"/>
                </HBox>

                <Title text="Step 2 — Simulate Sales Rush" class="sapUiSmallMarginBottom sapUiMediumMarginTop" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Simulate Sales Rush (Grade Cor×Tamanho → AEM → Agent)"
                    type="Critical"
                    icon="sap-icon://sales-order"
                    press=".onSimularVendas"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"/>
                </HBox>

                <Title text="Step 3 — Approve (via Joule or here)" class="sapUiSmallMarginBottom sapUiMediumMarginTop" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Generate Replenishment Orders (AI)"
                    type="Default"
                    icon="sap-icon://ai"
                    press=".onGerarReposicaoTodas"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"/>
                </HBox>

                <Title text="Step 4 — Simulate Receipt" class="sapUiSmallMarginBottom sapUiMediumMarginTop" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Simulate Goods Receipt (restock + AEM)"
                    type="Accept"
                    icon="sap-icon://shipping-status"
                    press=".onSimularRecebimento"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"/>
                </HBox>

                <Title text="AI Recommendations" class="sapUiSmallMarginBottom sapUiMediumMarginTop" level="H4"/>
                <HBox wrap="Wrap">
                  <Button
                    text="Generate AI Recommendations (all stores)"
                    type="Default"
                    icon="sap-icon://ai"
                    press=".onGerarRecomendacoesTodas"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"/>
                </HBox>

              </VBox>
            </content>
          </Panel>

          <!-- Scenario Simulator — Pilar 2 (Estoque Inteligente) + Pilar 5 (Substitutos) -->
          <Panel headerText="Scenario Simulator — Pillar 2: Smart Stock + Pillar 5: Substitutes" expandable="true" expanded="true">
            <content>
              <VBox class="sapUiSmallMargin">

                <MessageStrip
                  text="These scenarios simulate real-world demand shifts to demonstrate AI-driven stockout prediction and product substitution."
                  type="Information"
                  showIcon="true"
                  class="sapUiSmallMarginBottom"/>

                <Title text="Pillar 2 — Smart Stock (Color×Size Grade)" class="sapUiSmallMarginBottom" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Heat Wave +15% Demand (São Paulo / Sudeste)"
                    type="Critical"
                    icon="sap-icon://weather-sunny"
                    press=".onSimularOndaDeCalor"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                    tooltip="Increases 14d demand forecast by 15% — simulates extreme heat wave increasing sandal/beachwear demand. Recalculates stockout risk across the full Color×Size grid."/>
                </HBox>

                <Title text="Pillar 5 — Product Substitutes" class="sapUiSmallMarginBottom sapUiMediumMarginTop" level="H4"/>
                <HBox wrap="Wrap" class="sapUiSmallMarginBottom">
                  <Button
                    text="Sync Substitute Stock Availability"
                    type="Default"
                    icon="sap-icon://product"
                    press=".onSincronizarSubstitutos"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom"
                    tooltip="Recalculates estoqueDisponivel for each substitute product based on current network stock. Ensures Joule get_substitutos returns accurate availability."/>
                </HBox>

              </VBox>
            </content>
          </Panel>

          <!-- Log de operações -->
          <Panel headerText="Operations Log" expandable="true" expanded="true">
            <content>
              <List
                id="logList"
                items="{admin>/log}"
                noDataText="No operations performed yet."
                class="sapUiSmallMargin">
                <StandardListItem
                  title="{admin>msg}"
                  description="{admin>ts}"
                  icon="{admin>icon}"
                  iconInset="false"/>
              </List>
            </content>
          </Panel>

        </layout:VerticalLayout>
      </content>
    </Page>
  </App>
</mvc:View>
