{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.networkOvp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": { "version": "1.0.0" },
    "title": "Visão Geral da Rede",
    "description": "Network OVP — stockouts, NPS e pedidos da rede Tropicália",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": { "odataVersion": "4.0" }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "NetworkOvp-display": {
          "semanticObject": "NetworkOvp",
          "action": "display",
          "title": "Visão Geral da Rede",
          "subTitle": "Ruptura · NPS · Pedidos",
          "icon": "sap-icon://home",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://home" },
    "fullWidth": true
  },
  "sap.ovp": {
    "globalFilterModel": "mainService",
    "globalFilterEntityType": "StockoutAlerts",
    "enableLiveFilter": true,
    "considerAnalyticalParameters": true,
    "cards": {
      "card00": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.analytical",
        "settings": {
          "title": "SKUs em Ruptura",
          "subTitle": "Críticos e em Atenção",
          "entitySet": "StockoutAlerts",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#Donut",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Critical",
          "dataPointAnnotationPath": "com.sap.vocabularies.UI.v1.DataPoint#StockoutCount",
          "navigation": "dataPointNav"
        }
      },
      "card01": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.analytical",
        "settings": {
          "title": "Receita em Risco por Loja",
          "subTitle": "Top lojas com maior exposição",
          "entitySet": "StockoutAlerts",
          "chartAnnotationPath": "com.sap.vocabularies.UI.v1.Chart#RevenueByStore",
          "navigation": "dataPointNav"
        }
      },
      "card02": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "NPS por Loja",
          "subTitle": "Últimas respostas",
          "entitySet": "NpsResponses",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#NpsSummary",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      },
      "card03": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Pedidos Pendentes",
          "subTitle": "Aguardando ação",
          "entitySet": "Orders",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem#Pending",
          "selectionAnnotationPath": "com.sap.vocabularies.UI.v1.SelectionVariant#Pending",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ovp": {}
      }
    },
    "models": {
      "mainService": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": { "bundleName": "myfranchise.networkOvp.i18n.i18n" }
      }
    }
  }
}
