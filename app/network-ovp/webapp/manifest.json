{
  "_version": "1.65.0",
  "sap.app": {
    "id": "myfranchise.networkOvp",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "Network Overview",
    "description": "Network OVP — stockouts, NPS and orders — Tropicália",
    "dataSources": {
      "mainService": {
        "uri": "franqueadora/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "NetworkOvp-display": {
          "semanticObject": "NetworkOvp",
          "action": "display",
          "title": "Network Overview",
          "subTitle": "Stockout · NPS · Orders",
          "icon": "sap-icon://home",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://home"
    },
    "fullWidth": true
  },
  "sap.ovp": {
    "globalFilterModel": "mainService",
    "globalFilterEntityType": "StockoutAlerts",
    "enableLiveFilter": true,
    "considerAnalyticalParameters": true,
    "cards": {
      "card00": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Revenue at Risk by Store",
          "subTitle": "Critical & attention SKUs",
          "entitySet": "StockoutAlerts",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      },
      "card01": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Stockout Alerts",
          "subTitle": "Days to stockout — critical first",
          "entitySet": "StockoutAlerts",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      },
      "card02": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.table",
        "settings": {
          "title": "NPS by Store",
          "subTitle": "Latest responses",
          "entitySet": "NpsResponses",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      },
      "card03": {
        "model": "mainService",
        "template": "sap.ovp.cards.v4.list",
        "settings": {
          "title": "Pending Orders",
          "subTitle": "Awaiting action",
          "entitySet": "Orders",
          "annotationPath": "com.sap.vocabularies.UI.v1.LineItem",
          "addODataSelect": true,
          "navigation": "headerNav"
        }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ovp": {}
      }
    },
    "models": {
      "mainService": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "synchronizationMode": "None",
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "myfranchise.networkOvp.i18n.i18n"
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "myfranchise.service"
  }
}