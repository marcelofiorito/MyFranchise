{
  "_version": "1.84.0",
  "sap.app": {
    "id": "tropicalia.card02.previsao.receita",
    "type": "card",
    "title": "NPS da Rede",
    "subTitle": "Satisfação de clientes por loja — Tropicália Co.",
    "applicationVersion": {
      "version": "2.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://customer-and-contacts"
    }
  },
  "sap.card": {
    "type": "List",
    "configuration": {
      "destinations": {
        "RunMyFranchise-MCP": {
          "name": "RunMyFranchise-MCP",
          "label": "RunMyFranchise MCP",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-mcp.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/nps-avg",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value/0"
      },
      "title": "NPS Médio da Rede",
      "subTitle": "Escala 0–10 — todas as lojas ativas",
      "unitOfMeasurement": "/ 10",
      "mainIndicator": {
        "number": "{avg_nps}",
        "state": "{= parseFloat(${avg_nps}) >= 8 ? 'Good' : parseFloat(${avg_nps}) >= 6 ? 'Critical' : 'Error'}"
      },
      "sideIndicators": [
        {
          "title": "Respostas",
          "number": "{total_responses}"
        }
      ]
    },
    "content": {
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/nps-summary",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "item": {
        "icon": {
          "src": "{= parseFloat(${AVG_NPS}) >= 8 ? 'sap-icon://thumb-up' : parseFloat(${AVG_NPS}) >= 6 ? 'sap-icon://warning' : 'sap-icon://thumb-down'}",
          "backgroundColor": "{= parseFloat(${AVG_NPS}) >= 8 ? 'Accent7' : parseFloat(${AVG_NPS}) >= 6 ? 'Accent4' : 'Accent1'}"
        },
        "title": {
          "value": "{STORE_NAME}"
        },
        "description": {
          "value": "{= ${CITY} + ' — ' + ${RESPONSES} + ' respostas'}"
        },
        "info": {
          "value": "{= 'NPS ' + ${AVG_NPS}}",
          "state": "{NPS_STATE}"
        },
        "highlight": "{= parseFloat(${AVG_NPS}) >= 8 ? 'Success' : parseFloat(${AVG_NPS}) >= 6 ? 'Warning' : 'Error'}"
      }
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Analisar NPS no Joule",
          "actions": [
            {
              "type": "Navigation",
              "parameters": {
                "ibnTarget": {
                  "semanticObject": "StorePerformance",
                  "action": "display"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}
