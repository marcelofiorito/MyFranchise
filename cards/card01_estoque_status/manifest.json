{
  "_version": "1.58.0",
  "sap.app": {
    "id": "tropicalia.card01.estoque.status",
    "type": "card",
    "title": "Status do Estoque",
    "subTitle": "Grade Cor×Tamanho — minha loja",
    "applicationVersion": {
      "version": "1.0.3"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://donut-chart"
    }
  },
  "sap.card": {
    "type": "Analytical",
    "configuration": {
      "destinations": {
        "myfranchise-srv-wz": {
          "name": "myfranchise-srv-wz",
          "label": "MyFranchise API",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-srv.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueado/MeuEstoque/$count?$filter=status_code eq 'RUPTURA'",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        }
      },
      "title": "Rupturas na Grade",
      "subTitle": "Itens sem estoque disponível",
      "unitOfMeasurement": "SKUs",
      "mainIndicator": {
        "number": "{/}",
        "state": "{= parseInt(${/}) > 10 ? 'Error' : parseInt(${/}) > 0 ? 'Critical' : 'Good'}"
      }
    },
    "content": {
      "chartType": "Donut",
      "legend": {
        "visible": true,
        "position": "Bottom",
        "alignment": "Center"
      },
      "plotArea": {
        "dataLabel": {
          "visible": true
        },
        "colorPalette": [
          "#1F7A4D",
          "#FFCC2E",
          "#FF5A3C"
        ]
      },
      "title": {
        "text": "Distribuição por Status",
        "visible": true,
        "alignment": "Center"
      },
      "measureAxis": "size",
      "dimensionAxis": "color",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueado/MeuEstoque?$apply=groupby((status_code),aggregate($count as total))&$orderby=status_code asc",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "label": "Status",
          "value": "{status_code}"
        }
      ],
      "measures": [
        {
          "label": "Itens",
          "value": "{total}"
        }
      ]
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Abrir Grade Completa",
          "type": "Navigation",
          "parameters": {
            "ibnTarget": {
              "semanticObject": "GradeRuptura",
              "action": "display"
            }
          }
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}