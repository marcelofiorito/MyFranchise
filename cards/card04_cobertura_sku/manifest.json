{
  "_version": "1.58.0",
  "sap.app": {
    "id": "tropicalia.card04.cobertura.sku",
    "type": "card",
    "title": "Cobertura por SKU",
    "subTitle": "Dias de estoque disponível — minha loja",
    "applicationVersion": {
      "version": "1.0.3"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://horizontal-bar-chart"
    }
  },
  "sap.card": {
    "type": "Analytical",
    "designtime": "dt/configuration",
    "configuration": {
      "destinations": {
        "myfranchise-srv-wz": {
          "name": "myfranchise-srv-wz",
          "label": "MyFranchise API",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-srv.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueado/MeuEstoque?$apply=aggregate(coberturaDias with average as mediaCobertura)&$top=1",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value/0"
      },
      "title": "Cobertura Média",
      "subTitle": "Dias de estoque — minha loja",
      "unitOfMeasurement": "dias",
      "mainIndicator": {
        "number": "{mediaCobertura}",
        "state": "{= parseFloat(${mediaCobertura}) >= 14 ? 'Good' : parseFloat(${mediaCobertura}) >= 7 ? 'Critical' : 'Error'}"
      }
    },
    "content": {
      "chartType": "HorizontalBar",
      "legend": {
        "visible": false
      },
      "plotArea": {
        "dataLabel": {
          "visible": true
        },
        "colorPalette": [
          "#FF5A3C",
          "#FF8C42",
          "#FFCC2E",
          "#2A9D5C",
          "#1F7A4D",
          "#0B3D2E"
        ]
      },
      "title": {
        "text": "SKUs com menor cobertura (dias)",
        "visible": true,
        "alignment": "Center"
      },
      "measureAxis": "valueAxis",
      "dimensionAxis": "categoryAxis",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueado/MeuEstoque?$apply=groupby((sku),aggregate(coberturaDias with average as mediaCobertura))&$orderby=mediaCobertura asc&$top=6",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "label": "SKU",
          "value": "{sku}"
        }
      ],
      "measures": [
        {
          "label": "Cobertura (dias)",
          "value": "{mediaCobertura}"
        }
      ]
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Solicitar Reposição",
          "type": "Navigation",
          "parameters": {
            "ibnTarget": {
              "semanticObject": "ReplenishmentPortal",
              "action": "display"
            }
          }
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}