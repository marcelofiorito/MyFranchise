{
  "_version": "1.58.0",
  "sap.app": {
    "id": "tropicalia.card03.saude.regiao",
    "type": "card",
    "title": "Saúde da Rede por Região",
    "subTitle": "Score médio de saúde",
    "applicationVersion": {
      "version": "1.0.3"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://bar-chart"
    }
  },
  "sap.card": {
    "type": "Analytical",
    "configuration": {
      "destinations": {
        "myfranchise-srv-wz": {
          "name": "myfranchise-srv-wz",
          "label": "MyFranchise API",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-srv.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueador/Saude_Dashboard?$apply=aggregate(scoreSaude with average as mediaScore)&$top=1",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value/0"
      },
      "title": "Saúde da Rede",
      "subTitle": "Score médio — todas as lojas ativas",
      "unitOfMeasurement": "/ 100",
      "mainIndicator": {
        "number": "{mediaScore}",
        "state": "{= parseFloat(${mediaScore}) >= 70 ? 'Good' : parseFloat(${mediaScore}) >= 50 ? 'Critical' : 'Error'}"
      }
    },
    "content": {
      "chartType": "Bar",
      "legend": {
        "visible": false
      },
      "plotArea": {
        "dataLabel": {
          "visible": true
        },
        "colorPalette": [
          "#1F7A4D",
          "#2A9D5C",
          "#FFCC2E",
          "#FF8C42",
          "#FF5A3C"
        ]
      },
      "title": {
        "text": "Score por Região (Top 5)",
        "visible": true,
        "alignment": "Center"
      },
      "measureAxis": "valueAxis",
      "dimensionAxis": "categoryAxis",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv-wz}}/franqueador/Saude_Dashboard?$apply=groupby((regiao_code),aggregate(scoreSaude with average as mediaScore))&$orderby=mediaScore desc&$top=5",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "label": "Região",
          "value": "{regiao_code}"
        }
      ],
      "measures": [
        {
          "label": "Score Médio",
          "value": "{mediaScore}"
        }
      ]
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Ver Painel Admin",
          "type": "Navigation",
          "parameters": {
            "ibnTarget": {
              "semanticObject": "ControlPanel",
              "action": "display"
            }
          }
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}