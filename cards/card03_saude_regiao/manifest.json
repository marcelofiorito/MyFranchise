{
  "_version": "1.84.0",
  "sap.app": {
    "id": "tropicalia.card03.saude.regiao",
    "type": "card",
    "title": "Receita em Risco por Loja",
    "subTitle": "SKUs críticos e receita projetada perdida",
    "applicationVersion": {
      "version": "2.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://bar-chart"
    }
  },
  "sap.card": {
    "type": "Analytical",
    "configuration": {
      "destinations": {
        "RunMyFranchise-MCP": {
          "name": "RunMyFranchise-MCP",
          "label": "RunMyFranchise MCP",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-mcp.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/revenue-at-risk-total",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value/0"
      },
      "title": "Receita Total em Risco",
      "subTitle": "Projeção de perda — SKUs críticos",
      "unitOfMeasurement": "R$",
      "mainIndicator": {
        "number": "{= (parseFloat(${total_revenue_at_risk}) / 1000).toFixed(0)}",
        "unit": "K",
        "state": "{= parseFloat(${total_revenue_at_risk}) > 50000 ? 'Error' : parseFloat(${total_revenue_at_risk}) > 10000 ? 'Critical' : 'Good'}"
      },
      "sideIndicators": [
        {
          "title": "SKUs Críticos",
          "number": "{critical_skus}"
        }
      ]
    },
    "content": {
      "chartType": "Bar",
      "legend": {
        "visible": false
      },
      "plotArea": {
        "dataLabel": {
          "visible": true
        },
        "colorPalette": [
          "#FF5A3C",
          "#FFCC2E",
          "#1F7A4D"
        ]
      },
      "title": {
        "text": "Receita em Risco por Loja (R$)",
        "visible": true,
        "alignment": "Center"
      },
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/revenue-at-risk",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "dimensions": [
        {
          "name": "Loja",
          "value": "{STORE_NAME}"
        }
      ],
      "measures": [
        {
          "name": "Receita em Risco",
          "value": "{REVENUE_AT_RISK}"
        }
      ],
      "feeds": [
        {
          "type": "Dimension",
          "uid": "categoryAxis",
          "values": ["Loja"]
        },
        {
          "type": "Measure",
          "uid": "valueAxis",
          "values": ["Receita em Risco"]
        }
      ]
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Ver Detalhes no Joule",
          "actions": [
            {
              "type": "Navigation",
              "parameters": {
                "ibnTarget": {
                  "semanticObject": "StorePerformance",
                  "action": "display"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}
