{
  "_version": "1.84.0",
  "sap.app": {
    "id": "tropicalia.card05.pedidos.pendentes",
    "type": "card",
    "title": "My Replenishment Orders",
    "subTitle": "Order status — my store",
    "applicationVersion": {
      "version": "2.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://order-status"
    }
  },
  "sap.card": {
    "type": "Table",
    "configuration": {
      "parameters": {
        "store": {
          "value": "BR-SP-001",
          "label": "Store ID",
          "type": "string"
        }
      },
      "destinations": {
        "RunMyFranchise-MCP": {
          "name": "RunMyFranchise-MCP",
          "label": "RunMyFranchise MCP",
          "defaultUrl": "https://sa-build-platform-org-dev-myfranchise-mcp.cfapps.us10.hana.ondemand.com"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/my-orders?store={{parameters.store}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/summary"
      },
      "title": "Pending Orders",
      "subTitle": "Awaiting franchisor approval",
      "unitOfMeasurement": "orders",
      "mainIndicator": {
        "number": "{pending}",
        "state": "{= ${pending} > 3 ? 'Error' : ${pending} > 0 ? 'Critical' : 'Good'}"
      },
      "sideIndicators": [
        {
          "title": "Draft",
          "number": "{draft}"
        }
      ]
    },
    "content": {
      "data": {
        "request": {
          "url": "{{destinations.RunMyFranchise-MCP}}/cards/my-orders?store={{parameters.store}}",
          "method": "GET",
          "headers": {
            "Accept": "application/json"
          }
        },
        "path": "/value"
      },
      "row": {
        "highlight": "{status_state}",
        "columns": [
          {
            "title": "Order",
            "value": "{order_id}",
            "width": "30%",
            "identifier": true
          },
          {
            "title": "Date",
            "value": "{= ${order_date} ? ${order_date}.substring(8,10) + '/' + ${order_date}.substring(5,7) : '—'}",
            "width": "20%"
          },
          {
            "title": "Items",
            "value": "{item_count}",
            "hAlign": "End",
            "width": "15%"
          },
          {
            "title": "Total (R$)",
            "value": "{= parseFloat(${total_amount}).toLocaleString('pt-BR', {minimumFractionDigits:0})}",
            "hAlign": "End",
            "width": "20%"
          },
          {
            "title": "Status",
            "value": "{status}",
            "width": "15%",
            "state": "{status_state}"
          }
        ]
      }
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "New Order via Joule",
          "actions": [
            {
              "type": "Navigation",
              "parameters": {
                "ibnTarget": {
                  "semanticObject": "MyOrders",
                  "action": "display"
                }
              }
            }
          ]
        }
      ]
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}
