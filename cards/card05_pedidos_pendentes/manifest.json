{
  "_version": "1.58.0",
  "sap.app": {
    "id": "tropicalia.card05.pedidos.pendentes",
    "type": "card",
    "title": "Pedidos de Reposição",
    "subTitle": "Aguardando aprovação",
    "applicationVersion": { "version": "1.0.3" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "phone": true, "tablet": true },
    "icons": { "icon": "sap-icon://order-status" }
  },
  "sap.card": {
    "type": "Table",
    "designtime": "dt/configuration",
    "configuration": {
      "destinations": {
        "myfranchise-srv": {
          "name": "myfranchise-srv",
          "label": "MyFranchise API"
        }
      }
    },
    "header": {
      "type": "Numeric",
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueado/MinhasReposicoes/$count?$filter=status_code eq 'PENDENTE'",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        }
      },
      "title": "Pedidos Pendentes",
      "subTitle": "Aguardando aprovação da franqueadora",
      "unitOfMeasurement": "pedidos",
      "mainIndicator": {
        "number": "{/}",
        "state": "{= parseInt(${/}) > 5 ? 'Error' : parseInt(${/}) > 0 ? 'Critical' : 'Good'}"
      }
    },
    "content": {
      "data": {
        "request": {
          "url": "{{destinations.myfranchise-srv}}/franqueado/MinhasReposicoes?$filter=status_code eq 'PENDENTE'&$orderby=dataPedido desc&$top=8&$select=ID,sku,qtdSugerida,status_code,dataPedido,prazoDesejado",
          "method": "GET",
          "headers": { "Accept": "application/json" }
        },
        "path": "/value"
      },
      "row": {
        "highlight": "{= ${status_code} === 'PENDENTE' ? 'Warning' : ${status_code} === 'APROVADO' ? 'Success' : 'Error'}",
        "columns": [
          { "title": "SKU",    "value": "{sku}",           "width": "28%", "identifier": true },
          { "title": "Qtd",    "value": "{qtdSugerida}",   "hAlign": "End", "width": "12%" },
          { "title": "Prazo",  "value": "{prazoDesejado}", "width": "28%" },
          {
            "title": "Status", "value": "{status_code}", "width": "32%",
            "state": "{= ${status_code} === 'PENDENTE' ? 'Warning' : ${status_code} === 'APROVADO' ? 'Success' : 'Error'}"
          }
        ]
      }
    },
    "footer": {
      "actionsStrip": [
        {
          "text": "Aprovar Pedidos",
          "type": "Navigation",
          "parameters": { "ibnTarget": { "semanticObject": "AprovacaoPedidos", "action": "display" } }
        },
        {
          "text": "Novo Pedido",
          "type": "Navigation",
          "parameters": { "ibnTarget": { "semanticObject": "ReplenishmentPortal", "action": "display" } }
        }
      ]
    }
  },
  "sap.platform.mobilecards": { "compatible": false }
}
