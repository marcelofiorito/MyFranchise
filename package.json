{
  "name": "myfranchise",
  "version": "1.0.0",
  "description": "RunMyFranchise — Gestão de Redes de Franquias no SAP BTP",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cap-js/hana": "^2.8.0",
    "@sap-ai-sdk/orchestration": "^2.13.0",
    "@sap/cds": "^10",
    "@sap/hdi-deploy": "^5.7.0",
    "@sap/xssec": "^4.13.3",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.1.3"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        },
        "[production]": {
          "kind": "hana-cloud"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "gestor": {
            "password": "gestor",
            "roles": [
              "Franqueadora_Gestor"
            ]
          },
          "roberto": {
            "password": "roberto",
            "roles": [
              "Franqueado"
            ],
            "attr": {
              "unidade_ID": "u147",
              "cluster": "STD"
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  }
}
