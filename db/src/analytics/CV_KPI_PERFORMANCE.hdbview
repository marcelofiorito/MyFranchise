VIEW "CV_KPI_PERFORMANCE" ( "UNIDADE_ID", "STORE_NAME", "CITY", "REGION", "CLUSTER",
  "PERIODO", "REVENUE", "AVG_TICKET", "TRANSACTIONS", "MOM_GROWTH", "YOY_GROWTH", "NPS" ) AS
SELECT
  K."UNIDADE_ID",
  U."NOME",
  U."CIDADE",
  U."REGIAO_CODE",
  U."CLUSTER_CODE",
  K."PERIODO",
  K."FATURAMENTO",
  K."TICKETMEDIO",
  K."QTDTRANSACOES",
  K."CRESCIMENTOMOM",
  K."CRESCIMENTOYOY",
  K."NPS"
FROM "MYFRANCHISE_KPI_UNIDADE" K
LEFT JOIN "MYFRANCHISE_UNIDADES" U ON K."UNIDADE_ID" = U."ID"
WITH READ ONLY
