VIEW "CV_INVENTORY_STATUS" ( "UNIDADE_ID", "STORE_NAME", "CITY", "REGION",
  "SKU", "PRODUCT_NAME", "CATEGORY", "CURRENT_STOCK", "MIN_STOCK",
  "COVERAGE_DAYS", "LEAD_TIME", "CRITICALITY", "STATUS" ) AS
SELECT
  E."UNIDADE_ID",
  U."NOME",
  U."CIDADE",
  U."REGIAO_CODE",
  E."SKU",
  E."NOMEPRODUTO",
  E."CATEGORIA",
  E."SALDOATUAL",
  E."ESTOQUEMINIMO",
  E."COBERTURADIAS",
  E."LEADTIMEDIAS",
  E."ESTOQUECRITICALITY",
  E."STATUS_CODE"
FROM "MYFRANCHISE_ESTOQUE_UNIDADE" E
LEFT JOIN "MYFRANCHISE_UNIDADES" U ON E."UNIDADE_ID" = U."ID"
WITH READ ONLY
