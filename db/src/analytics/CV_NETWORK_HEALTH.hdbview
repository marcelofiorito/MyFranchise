VIEW "CV_NETWORK_HEALTH" ( "UNIDADE_ID", "STORE_NAME", "CITY", "REGION", "CLUSTER",
  "HEALTH_SCORE", "COMPLIANCE_PCT", "PERFORMANCE_PCT", "CRITICALITY",
  "HIGH_ALERTS", "LAST_UPDATED" ) AS
SELECT
  S."UNIDADE_ID",
  U."NOME",
  U."CIDADE",
  U."REGIAO_CODE",
  U."CLUSTER_CODE",
  S."SCORESAUDE",
  S."COMPLIANCEPCT",
  S."PERFORMANCEPCT",
  S."SCORECRITICALITY",
  S."QTDALERTASALTA",
  S."DATAATUALIZACAO"
FROM "MYFRANCHISE_SAUDE_UNIDADE" S
LEFT JOIN "MYFRANCHISE_UNIDADES" U ON S."UNIDADE_ID" = U."ID"
WITH READ ONLY
